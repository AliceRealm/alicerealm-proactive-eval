{
  "name": "EigenFlux v2 keyword extraction",
  "description": "Test new keyword extraction against agent-driven search",
  "model": "claude-haiku-4-5-20251001",
  "max_tokens": 1024,
  "temperature": 0.0,
  "source": "eigenflux",
  "time_range": {
    "start": "2026-04-15T11:15+00:00",
    "end": null
  },
  "sampling": {
    "size": 100,
    "seed": 42
  },
  "dedup": "semantic",
  "fixtures": "all",
  "pre_steps": ["clear_impressions"],
  "targets": {
    "daily_sends": 15,
    "send_rate": 0.70,
    "action_rate": 0.15
  },
  "workers": 4,
  "search": {
    "provider": "duckduckgo",
    "max_results_per_query": 5,
    "sleep_between_queries": 5,
    "queries_file": "search_queries.json"
  }
}
